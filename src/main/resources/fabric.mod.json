{
  "schemaVersion": 1,
  "id": "themis",
  "version": "${version}",

  "name": "Themis Lib",
  "description": "纯数据记录与接口提供型 Carpet 附属模组：采集游戏行为 → 按玩家/假人分域累计 → 持久化到 SQLite → 通过 Java API（可选 Scarpet 函数）暴露数据。不提供任何查询命令、排行榜、计分板或 UI。",
  "authors": [
    "Themis"
  ],
  "contact": {},

  "license": "MIT",

  "environment": "server",
  "entrypoints": {
    "main": [
      "themislib.ThemisLib::onInitialize"
    ]
  },
  "mixins": [
    "themis.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "carpet": "*"
  }
}
